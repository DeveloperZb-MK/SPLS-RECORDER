<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <!-- MapLibre map surface. The fragment is inserted into @id/map by MapActivity. -->
    <include
        android:id="@+id/map_container"
        layout="@layout/map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Search field is declared directly here so ActivityMapBinding exposes searchBox. -->
    <EditText
        android:id="@+id/searchBox"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_box_height"
        android:layout_gravity="top"
        android:layout_marginStart="18dp"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/search_box_background"
        android:drawableStart="@drawable/ic_baseline_search_24"
        android:drawablePadding="@dimen/padding_16"
        android:hint="@string/search"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingStart="@dimen/padding_16"
        android:paddingEnd="52dp" />

    <ProgressBar
        android:id="@+id/searchProgress"
        android:layout_width="@dimen/progressbar_size"
        android:layout_height="@dimen/progressbar_size"
        android:layout_gravity="top|end"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="30dp"
        android:padding="@dimen/padding_8"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/getlocation"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="96dp"
        android:alpha="0.95"
        android:contentDescription="@string/getlocation_desc"
        android:elevation="10dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_baseline_my_location_24"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="32dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/spls_button"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="168dp"
        android:alpha="0.95"
        android:contentDescription="SPLS"
        android:elevation="10dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_pref_brain_small"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="32dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mapType"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="240dp"
        android:alpha="0.95"
        android:contentDescription="Change map style"
        android:elevation="10dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_map_type"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="32dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/zoom_out"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="96dp"
        android:alpha="0.95"
        android:contentDescription="@string/zoom_out_desc"
        android:elevation="10dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_zoom_minus"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="28dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/zoom_in"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="156dp"
        android:alpha="0.95"
        android:contentDescription="@string/zoom_in_desc"
        android:elevation="10dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:icon="@drawable/ic_zoom_plus"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="28dp" />

</FrameLayout>
