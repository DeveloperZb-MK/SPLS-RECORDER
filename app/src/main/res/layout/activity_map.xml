<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <RelativeLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/search_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="10dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="10dp"
            android:elevation="8dp">

            <EditText
                android:id="@+id/search_box"
                android:layout_width="match_parent"
                android:layout_height="@dimen/search_box_height"
                android:background="@drawable/search_box_background"
                android:drawableStart="@drawable/ic_baseline_search_24"
                android:drawablePadding="@dimen/padding_16"
                android:hint="@string/search"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="@dimen/padding_16"
                android:paddingEnd="52dp" />

            <ProgressBar
                android:id="@+id/search_progress"
                android:layout_width="@dimen/progressbar_size"
                android:layout_height="@dimen/progressbar_size"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:padding="@dimen/padding_8"
                android:visibility="gone" />
        </RelativeLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/getlocation"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="96dp"
            android:alpha="0.95"
            android:contentDescription="@string/my_location_desc"
            android:elevation="10dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_baseline_my_location_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/spls_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_above="@id/getlocation"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="32dp"
            android:alpha="0.95"
            android:contentDescription="@string/spls_desc"
            android:elevation="10dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_pref_brain_small"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/map_type"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_above="@id/spls_button"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="32dp"
            android:alpha="0.95"
            android:contentDescription="@string/map_type_desc"
            android:elevation="10dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_map_type"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/zoom_out"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="96dp"
            android:alpha="0.95"
            android:contentDescription="@string/zoom_out_desc"
            android:elevation="10dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_zoom_minus"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/zoom_in"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_above="@id/zoom_out"
            android:layout_alignParentStart="true"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.95"
            android:contentDescription="@string/zoom_in_desc"
            android:elevation="10dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_zoom_plus"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="28dp" />
    </RelativeLayout>
</FrameLayout>
